{"_type": "game", "_id": "game-star-wars-outlaws", "title": "Star Wars Outlaws", "officialRequirements": {"os": "Windows 10/11", "ram": 16, "gpu": "NVIDIA GeForce GTX 1660 (6GB) / AMD RX 5600XT (6GB) / Intel Arc A750 (8GB)", "storage": 65}, "officialSource": {"_type": "reference", "_ref": "cab4fd04-ed1d-48ad-b6ef-1aa5ee4b4b4c"}, "officialSourceUrl": "https://store.steampowered.com/app/2842040/Star_Wars_Outlaws/", "protonRating": "Gold", "deckVerified": "Unsupported", "protonReportCount": 86, "knownFixes": [{"issue": "Textures not loading correctly", "fix": "Edit graphic settings.cfg. Change streamer dedicated budget from 64 to 5120 (or 2048 for less than 8GB VRAM).", "sourceUrl": "https://www.pcgamingwiki.com/wiki/Star_Wars_Outlaws"}, {"issue": "Severe performance drops with RTX Direct Lighting (RTXDI)", "fix": "Reduce RTXDI to lowest setting or disable. Lower overall ray tracing preset.", "sourceUrl": "https://www.pcgamingwiki.com/wiki/Star_Wars_Outlaws"}, {"issue": "Traversal stutter / streaming hitching", "fix": "Install/run on SSD (NVMe recommended). Avoid HDDs. Reduce Texture Quality.", "sourceUrl": "https://www.pcgamingwiki.com/wiki/Star_Wars_Outlaws"}, {"issue": "Xbox button prompts flickering through DualSense prompts", "fix": "Edit state.cfg. In [Input] section, replace ControllersMode = 0 with ControllersMode = 4.", "sourceUrl": "https://www.pcgamingwiki.com/wiki/Star_Wars_Outlaws"}, {"issue": "Unlock additional graphics settings", "fix": "Use -unlockmaxsettings command line argument", "sourceUrl": "https://www.pcgamingwiki.com/wiki/Star_Wars_Outlaws"}]}
